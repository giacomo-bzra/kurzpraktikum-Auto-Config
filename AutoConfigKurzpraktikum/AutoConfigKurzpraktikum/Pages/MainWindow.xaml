<Window x:Class="AutoConfigKurzpraktikum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoConfigKurzpraktikum"
        mc:Ignorable="d"
        Title="AutoConfig – Garage" Height="500" Width="700"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        
        <Label Grid.Row="0" Content="Meine Garage"
               FontSize="28" FontWeight="Bold"
               VerticalAlignment="Center" Margin="15,0,0,0"/>
        
        <ListBox Grid.Row="1"
                 x:Name="CarListBox"
                 ItemsSource="{Binding SavedCars}"
                 SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="10,5,10,5"
                 Background="Transparent"
                 BorderThickness="1"
                 BorderBrush="#CCCCCC">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Left" Margin="5"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2D2D2D" Width="150" Height="100"
                            CornerRadius="6" Margin="6" Padding="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Brand}"
                                       FontWeight="Bold" FontSize="13"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Modell}"
                                       FontSize="12"
                                       Foreground="#AAAAAA"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0} CHF}"
                                       FontSize="11"
                                       Foreground="#4FC3F7"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                            <TextBlock FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⚙ Getunt"/>
                                        <Setter Property="Foreground" Value="#81C784"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        
        <TextBlock Grid.Row="1"
                   Text="Keine gespeicherten Autos. Erstelle ein neues!"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="Gray"
                   Visibility="{Binding EmptyStateVisibility}"/>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="➕  Neu konfigurieren"
                    Height="38" Margin="15,0,8,11"
                    Background="#388E3C" Foreground="White"
                    FontWeight="SemiBold"
                    Click="Button_CreateNew"/>

            <Button Grid.Column="1"
                    Content="✏  Bearbeiten"
                    Height="38" Margin="8,0,8,11"
                    Background="#1565C0" Foreground="White"
                    FontWeight="SemiBold"
                    Click="Button_Edit"/>

            <Button Grid.Column="2"
                    Content="🗑  Löschen"
                    Height="38" Margin="8,0,15,11"
                    Background="#C62828" Foreground="White"
                    FontWeight="SemiBold"
                    Click="Button_Delete"/>
        </Grid>
    </Grid>
</Window>
