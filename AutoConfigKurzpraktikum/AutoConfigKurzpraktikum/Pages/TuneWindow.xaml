<Window x:Class="AutoConfigKurzpraktikum.TuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AutoConfigKurzpraktikum"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="TuneWindow" Height="400" Width="700">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/> <ColumnDefinition Width="*"/>   </Grid.ColumnDefinitions>
                
        <Grid Grid.Column="0">
            <GridSplitter Width="2" Background="Black" HorizontalAlignment="Right"/> 
            
            <Label Content="Modification:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5 0 0 0" FontSize="40"/>

            <Label Content="Brake:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15 80 0 0"/>
            <ComboBox Name="Brake" Width="180" Height="25" ItemsSource="{Binding BrakeOptions}" DisplayMemberPath="Name" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20 100 0 0"/>
            
            <Label Content="Engine:" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 80 155 0"/>
            <ComboBox Name="Engine" Width="180" Height="25" ItemsSource="{Binding EngineOptions}" DisplayMemberPath="Name" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 100 20 0"/>
            
            <Label Content="Frontspoiler:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15 -40 20 0"/>
            <ComboBox Name="Frontspoiler" Width="180" Height="25" ItemsSource="{Binding FrontspoilerOptons}" DisplayMemberPath="Name" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 20 0"/>
            
            <Label Content="Heckspoiler:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 -40 130 0"/>
            <ComboBox Name="Heckspoiler" Width="180" Height="25" ItemsSource="{Binding HeckspoilerOptions}" DisplayMemberPath="Name" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 20 0"/>
            
            <Label Content="Rimm:" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15 0 20 120"/>
            <ComboBox Name="Rimm" Width="180" Height="25" ItemsSource="{Binding RimmOptions}" DisplayMemberPath="Name" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20 0 20 100"/>
            
            <Label Content="Tire:" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0 0 170 120"/>
            <ComboBox Name="Tire" Width="180" Height="25" ItemsSource="{Binding TireOptions}" DisplayMemberPath="Name" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0 0 20 100"/>
            
            <Button Name="Select" Content="Select" Height="40" Width="200" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 20 0 20" Click="Button_select"/>
        </Grid>
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0 0 0 2" VerticalAlignment="Center"/>
            
            <Label Grid.Row="0" Content="placeholer picture"/>

            <Label Grid.Row="2" Content="Color:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0 0 0 0"/>
            <xctk:ColorPicker Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0 20 0 0"/>
        </Grid>
        
    </Grid>
</Window>