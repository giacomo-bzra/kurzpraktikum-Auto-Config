<Window x:Class="AutoConfigKurzpraktikum.TuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AutoConfigKurzpraktikum"
        mc:Ignorable="d"
        Title="TuneWindow" Height="400" Width="700">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/> <ColumnDefinition Width="*"/>   </Grid.ColumnDefinitions>
                
        <Grid Grid.Column="0">
            <GridSplitter Width="2" Background="Black" HorizontalAlignment="Right"/> 
            
            <Label Content="Modification:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5 0 0 0" FontSize="40"/>

            <ComboBox Name="Brake" Width="180" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20 100 0 0">
                <ComboBoxItem Content="placeholder1"/>
                <ComboBoxItem Content="placeholder2"/>
                <ComboBoxItem Content="placeholder3"/>
            </ComboBox>
            
            <ComboBox Name="Engine" Width="180" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 100 20 0">
                <ComboBoxItem Content="placeholder1"/>
                <ComboBoxItem Content="placeholder2"/>
                <ComboBoxItem Content="placeholder3"/>
            </ComboBox>
            
            <ComboBox Name="Frontspoiler" Width="180" Height="25" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 20 0">
                <ComboBoxItem Content="placeholder1"/>
                <ComboBoxItem Content="placeholder2"/>
                <ComboBoxItem Content="placeholder3"/>
            </ComboBox>
            
            <ComboBox Name="Heckspoiler" Width="180" Height="25" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 20 0">
                <ComboBoxItem Content="placeholder1"/>
                <ComboBoxItem Content="placeholder2"/>
                <ComboBoxItem Content="placeholder3"/>
            </ComboBox>
            
            <ComboBox Name="Rimm" Width="180" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20 0 20 100">
                <ComboBoxItem Content="placeholder1"/>
                <ComboBoxItem Content="placeholder2"/>
                <ComboBoxItem Content="placeholder3"/>
            </ComboBox>
            
            <ComboBox Name="Tire" Width="180" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0 0 20 100">
                <ComboBoxItem Content="placeholder1"/>
                <ComboBoxItem Content="placeholder2"/>
                <ComboBoxItem Content="placeholder3"/>
            </ComboBox>
            
            <Button Name="Select" Content="Select" Height="40" Width="200" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 20 0 20" Click="Button_select"/>
        </Grid>
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0 0 0 2" VerticalAlignment="Center"/>
            
            <Label Grid.Row="0" Content="placeholer picture"/>
            <Label Grid.Row="2" Content="placeholder color changer"/>
        </Grid>
        
    </Grid>
</Window>