<Window x:Class="AutoConfigKurzpraktikum.TuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AutoConfigKurzpraktikum"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="TuneWindow" Height="480" Width="720">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
            
        <Grid Grid.Column="0">
            <GridSplitter Width="2" Background="Black" HorizontalAlignment="Right"/>

            <Label Content="Modification:" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="5,0,0,0" FontSize="36"/>
            
            <Label Content="Bremse:" VerticalAlignment="Top" HorizontalAlignment="Left"  Margin="15,78,0,0"/>
            <ComboBox Name="CombBrake"
                      ItemsSource="{Binding BrakeOptions}"
                      SelectedItem="{Binding SelectedBrake}"
                      DisplayMemberPath="Name"
                      Width="180" Height="25"
                      VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,98,0,0"/>

            <Label Content="Motor:" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,78,155,0"/>
            <ComboBox Name="CombEngine"
                      ItemsSource="{Binding EngineOptions}"
                      SelectedItem="{Binding SelectedEngine}"
                      DisplayMemberPath="Name"
                      Width="180" Height="25"
                      VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,98,20,0"/>
            
            <Label Content="Frontspoiler:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,-40,20,0"/>
            <ComboBox Name="CombFrontspoiler"
                      ItemsSource="{Binding FrontspoilerOptions}"
                      SelectedItem="{Binding SelectedFrontspoiler}"
                      DisplayMemberPath="Name"
                      Width="180" Height="25"
                      VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,20,0"/>

            <Label Content="Heckspoiler:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-40,130,0"/>
            <ComboBox Name="CombHeckspoiler"
                      ItemsSource="{Binding HeckspoilerOptions}"
                      SelectedItem="{Binding SelectedHeckspoiler}"
                      DisplayMemberPath="Name"
                      Width="180" Height="25"
                      VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
            
            <Label Content="Felge:" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15,0,20,150"/>
            <ComboBox Name="CombRimm"
                      ItemsSource="{Binding RimmOptions}"
                      SelectedItem="{Binding SelectedRimm}"
                      DisplayMemberPath="Name"
                      Width="180" Height="25"
                      VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,20,128"/>

            <Label Content="Reifen:" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,170,150"/>
            <ComboBox Name="CombTire"
                      ItemsSource="{Binding TireOptions}"
                      SelectedItem="{Binding SelectedTire}"
                      DisplayMemberPath="Name"
                      Width="180" Height="25"
                      VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,128"/>
            
            <Label Content="Modellname:" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15,0,20,90"/>
            <TextBox Name="TxtModelName"
                     Width="400" Height="28"
                     VerticalAlignment="Bottom" HorizontalAlignment="Left"
                     Margin="20,0,20,60"
                     Text="{Binding SelectedCar.Modell, UpdateSourceTrigger=PropertyChanged}"/>

            <Button x:Name="SelectBtn"
                    Content="✔  Konfiguration speichern"
                    Height="40" Width="200"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Background="#388E3C" Foreground="White" FontWeight="SemiBold"
                    Click="Button_Select"/>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
                
            <Canvas x:Name="AutoBild"
                    Grid.Row="0"
                    Width="200" Height="120"
                    Background="Transparent"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Separator Grid.Row="1" Margin="5,0"/>

            <StackPanel Grid.Row="2" Margin="8,6,8,10">
                <Label Content="Karosseriefarbe:"
                       FontWeight="SemiBold" Margin="0,0,0,2"/>

                <xctk:ColorPicker x:Name="CarColorPicker"
                                  SelectedColorChanged="CarColorPicker_SelectedColorChanged"
                                  Width="200"
                                  HorizontalAlignment="Left"/>


                <WrapPanel x:Name="ColorSwatches" Margin="0,6,0,0">
                    <Button Tag="#1565C0" Width="24" Height="24" Margin="2" Background="#1565C0"
                            ToolTip="Blau" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#C62828" Width="24" Height="24" Margin="2" Background="#C62828"
                            ToolTip="Rot" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#2E7D32" Width="24" Height="24" Margin="2" Background="#2E7D32"
                            ToolTip="Grün" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#F9A825" Width="24" Height="24" Margin="2" Background="#F9A825"
                            ToolTip="Gelb" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#6A1B9A" Width="24" Height="24" Margin="2" Background="#6A1B9A"
                            ToolTip="Lila" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#37474F" Width="24" Height="24" Margin="2" Background="#37474F"
                            ToolTip="Dunkelgrau" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#795548" Width="24" Height="24" Margin="2" Background="#795548"
                            ToolTip="Braun" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#ECEFF1" Width="24" Height="24" Margin="2" Background="#ECEFF1"
                            ToolTip="Weiß" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#000000" Width="24" Height="24" Margin="2" Background="#000000"
                            ToolTip="Schwarz" Click="Swatch_Click" BorderThickness="1" BorderBrush="White"/>
                    <Button Tag="#B71C1C" Width="24" Height="24" Margin="2" Background="#B71C1C"
                            ToolTip="Dunkelrot" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#4A90D9" Width="24" Height="24" Margin="2" Background="#4A90D9"
                            ToolTip="Hellblau" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                    <Button Tag="#FF6F00" Width="24" Height="24" Margin="2" Background="#FF6F00"
                            ToolTip="Orange" Click="Swatch_Click" BorderThickness="1" BorderBrush="Black"/>
                </WrapPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Label Content="Gewählt:" VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <Border x:Name="SelectedColorPreview"
                            Width="40" Height="20"
                            BorderBrush="Black" BorderThickness="1"
                            CornerRadius="3"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
