<Window x:Class="AutoConfigKurzpraktikum.Pages.CarConfigur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AutoConfigKurzpraktikum.Pages"
        mc:Ignorable="d"
        Title="CarConfigur" Height="400" Width="600">
    <Grid>
        <Label Content="Auto Configuration:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5 0 0 0" FontSize="40"/>
        
        
        <Canvas Name="AutoBild" Width="400" Height="200" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>      
        
        
        <Button Name="ButtonLeft" Content="Left" Height="50" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30 0 30 0" Click="Button_Left"/>
        <Button Name="ButtonRight" Content="Right" Height="50" Width="50" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="30 0 30 0" Click="Button_Right"/>
        <Button Name="Select" Content="Select" Height="40" Width="200" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 20 0 20" Click="Button_select"/>
        
        
        <Label Name="count" Content="" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="16"/>
    </Grid>
</Window>
