<Window x:Class="AutoConfigKurzpraktikum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoConfigKurzpraktikum"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600">
    <Grid>
        <Label Content="Auto Select:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5 0 0 0" FontSize="40"/>
        
        <ListBox ItemsSource="{Binding BaseCar}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="Auto" Width="Auto" Margin="0 70 0 70">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel></WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Height="50" Width="50" Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Background="DarkGray"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Margin" Value="5"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        
        <Button Content="Create New" Height="40" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="350 0 0 15" Click="Button_CreateNew"/>
        <Button Content="Edit" Height="40" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0 0 0 15" Click="Button_Edit"/>
        <Button Content="Delete" Height="40" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0 0 350 15" Click="Button_Delete"/>
    </Grid>
</Window>
